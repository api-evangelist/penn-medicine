      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://ssproxy.pennhealth.com/PRD-FHIR/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
